erDiagram
    %% Capa Local (SQLite)
    USERS {
        int id PK
        string name
        string email UK
        string password_hash
        string created_at
    }

    PROFILES {
        int user_id PK, FK
        string username
        string gmail
        int cycle_duration
        int period_duration
        string profile_image_path
        int notif_periodo
        int notif_ovulacion
        int notif_pildora
        int notif_hidratacion
        int notif_ejercicio
        int notif_app
        int notif_sonidos
        int notif_cita_medica
    }

    DAILY_LOGS {
        int id PK
        int user_id FK
        string date
        int period_start
        string symptoms
        string sexo
        string flujo
        string created_at
    }

    %% Capa Backend (FastAPI)
    USER_PROFILES {
        int id PK
        int menstrual_cycle_duration
        int menstruation_duration
        string collection_product
        string contraceptive
        int age
        float weight
        string weight_unit
        bool breast_exam_reminder
        bool privacy_policy_accepted
        datetime updated_at
    }

    ADDITIONAL_MEDICATIONS {
        int id PK
        int user_id FK
        string name
        string category
        datetime updated_at
    }

    DAILY_LOGS_BACKEND {
        int id PK
        int user_id FK
        string date
        bool period_start
        bool period_end
        bool sexual_intercourse
        string bleeding_intensity
        string notes
        datetime updated_at
    }

    %% Relaciones Locales
    USERS ||--|| PROFILES : "1:1 tiene perfil"
    USERS ||--o{ DAILY_LOGS : "1:N registra"

    %% Relaciones Backend
    USER_PROFILES ||--o{ ADDITIONAL_MEDICATIONS : "1:N toma"
    USER_PROFILES ||--o{ DAILY_LOGS_BACKEND : "1:N registra"
